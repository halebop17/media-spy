<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MediaSpy</string>
    <key>CFBundleDisplayName</key>
    <string>MediaSpy</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>

    <!-- "Open With MediaSpy" for media files -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Media File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.audio</string>
                <string>public.audiovisual-content</string>
                <string>public.image</string>
                <string>public.mpeg-4</string>
                <string>com.apple.quicktime-movie</string>
                <string>org.matroska.mkv</string>
                <string>public.mp3</string>
                <string>com.microsoft.waveform-audio</string>
                <string>public.jpeg</string>
                <string>public.png</string>
                <string>public.heic</string>
            </array>
        </dict>
    </array>

    <!-- "Get Media Info" right-click Finder Service (M3). Handler:
         MediaInfoServiceProvider.getMediaInfo(_:userData:error:) -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Get Media Info</string>
            </dict>
            <key>NSMessage</key>
            <string>getMediaInfo</string>
            <key>NSPortName</key>
            <string>MediaSpy</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
            </array>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.audio</string>
                <string>public.audiovisual-content</string>
                <string>public.image</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
